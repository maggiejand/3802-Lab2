clc;
clear;
close all;


%% Reading in Data
A =readmatrix('Aluminum_25V_240mA');


time = A(:,1);
CH1 = A(:,2);
CH2 = A(:,3);
CH3 = A(:,4);
CH4 = A(:,5);
CH5 = A(:,6);
CH6 = A(:,7);
CH7 = A(:,8);
CH8 = A(:,9);

T0 = A(1,2:9);

%% Polyfit
x1 = 1 + 3/8;
x2 = x1 +.5;
x3 = x2 + .5;
x4 = x3 + .5;
x5 = x4 +.5;
x6 = x5 +.5;
x7 = x6 +.5;
x8 = x7 +.5;

X =[x1,x2,x3,x4,x5,x6,x7,x8];

p = polyfit(X,T0,1);
Tfit = polyval(p,X);









function resultsTable = generateHeatTable(cases, T0, Hexp, Han)

    T0   = T0(:);
    Hexp = Hexp(:);
    Han  = Han(:);

    % Create table
    resultsTable = table(cases(:), T0, Hexp, Han, ...
        'VariableNames', {'Case', 'T0_C', 'Hexp_C_per_m', 'Han_C_per_m'});
end














